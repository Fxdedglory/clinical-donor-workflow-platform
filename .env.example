POSTGRES_DB=clinical_donor_workflow
POSTGRES_USER=clinical_admin
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Local no-Docker development should use localhost, not Docker host "db".
DATABASE_URL=postgresql+psycopg://clinical_admin@localhost:5433/clinical_donor_workflow
APP_BASE_URL=http://localhost:8000
PORT=8000
STARTUP_MODE=fastapi_react
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=frontend/dist
VITE_API_BASE_URL=
SEED_RECORDS=1200
APP_ENV=dev
SECRET_KEY=change-me-for-production-demo-only
ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRATION_DAYS=180
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MFA_DEV_BYPASS_CODE=000000
DOCUMENT_SIGNED_URL_MINUTES=10
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@teemails.com
EMAIL_FROM_NAME=Clinical Donor Workflow
SENDGRID_API_KEY=
SES_REGION=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CLOUDFLARE_TUNNEL_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,https://teemails.com,https://www.teemails.com
ENABLE_DATA_PRODUCER_API=true
DATA_PRODUCER_METADATA_ROOT=data/generated
DATA_PRODUCER_EXPORT_ROOT=data/exports
DATA_PRODUCER_STOP_FILE=data/generated/STOP_CONTINUOUS
DATA_PRODUCER_MIN_INTERVAL_SECONDS=1
DATA_PRODUCER_MAX_CYCLES=1000
DATA_PRODUCER_ALLOW_INFINITE=false

# ADLS Gen2 Parquet lake upload. Use managed identity in Azure; do not use
# storage account keys in source control.
DATA_LAKE_ACCOUNT_NAME=stteemailslakewcus
DATA_LAKE_CONTAINER=datalake
DATA_LAKE_AUTH_MODE=managed_identity
DATA_LAKE_BASE_PATH=bronze
